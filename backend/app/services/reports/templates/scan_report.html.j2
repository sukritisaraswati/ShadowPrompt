<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>ShadowScan report</title>
<style>
  :root { --navy:#0f1b2d; --accent:#1f5f96; --muted:#5b6b7f; --line:#d5dde6; --zebra:#f5f8fb; }
  * { box-sizing: border-box; }
  body { font-family: "Segoe UI", Calibri, Arial, sans-serif; color:#1e2a38; margin:0; background:#fff; line-height:1.5; }
  main { max-width: 960px; margin: 0 auto; padding: 32px 24px 48px; }
  h1 { color: var(--navy); margin: 0 0 4px; font-size: 28px; }
  h2 { color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: 4px; margin-top: 36px; font-size: 20px; }
  .muted { color: var(--muted); }
  .cover { border: 1px solid var(--line); border-radius: 8px; padding: 20px; display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; }
  .target { word-break: break-all; font-family: Consolas, monospace; font-size: 13px; }
  .score { text-align: center; min-width: 140px; }
  .score .num { font-size: 48px; font-weight: 700; line-height: 1; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; color: #fff; font-weight: 600; font-size: 13px; }
  .sev-clean { background:#15803d; } .sev-low { background:#0e7490; } .sev-medium { background:#a16207; }
  .sev-high { background:#c2410c; } .sev-critical { background:#b91c1c; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { border: 1px solid var(--line); padding: 6px 8px; text-align: left; vertical-align: top; }
  th { background: #dce8f4; color: var(--navy); }
  tr:nth-child(even) td { background: var(--zebra); }
  pre.evidence { white-space: pre-wrap; word-break: break-all; margin: 0; font-family: Consolas, monospace; font-size: 12px; background:#f1f4f8; border:1px solid var(--line); border-radius:4px; padding:6px; }
  .notice { border-left: 4px solid #c68a00; background: #fff6e0; padding: 10px 14px; border-radius: 4px; }
  ul.checklist li { margin-bottom: 6px; }
  footer { margin-top: 40px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px; }
</style>
</head>
<body>
<main>
  <h1>ShadowScan Report</h1>
  <p class="muted">Webpage prompt-injection analysis &middot; generated {{ generated_at }}</p>

  <section class="cover">
    <div>
      <div class="muted">Target ({{ result.source_kind.value }})</div>
      <div class="target">{{ target }}</div>
      <div class="muted" style="margin-top:8px">Scanned {{ scanned_at }} &middot; Scan ID {{ result.id }}</div>
    </div>
    <div class="score">
      <div class="num">{{ result.score }}</div>
      <div class="muted">risk score / 100</div>
      <div style="margin-top:6px"><span class="badge sev-{{ result.severity.level.value }}">{{ result.severity.label }}</span></div>
    </div>
  </section>

  <h2>Executive summary</h2>
  <p>{{ summary }}</p>

  <h2>Findings</h2>
  {% if result.findings %}
  <table>
    <thead><tr><th>#</th><th>Source</th><th>Category</th><th>Evidence</th><th>Impact</th><th>Fix</th></tr></thead>
    <tbody>
    {% for f in result.findings %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>{{ f.source_label }}</td>
        <td>{{ f.category_label }}</td>
        <td><pre class="evidence">{{ f.evidence_text }}</pre></td>
        <td>{{ f.impact }}</td>
        <td>{{ f.remediation }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No findings. No configured detection rule matched any of the extracted content.</p>
  {% endif %}

  {% if result.findings %}
  <h2>Technical detail</h2>
  <table>
    <thead><tr><th>#</th><th>Matched rule</th><th>Element</th><th>Risk weight</th></tr></thead>
    <tbody>
    {% for f in result.findings %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><code>{{ f.matched_rule }}</code><br><span class="muted">{{ f.rule_description }}</span></td>
        <td><code>{{ f.locator or "" }}</code></td>
        <td>{{ f.risk_weight }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if result.extraction_summary %}
  <h2>Coverage</h2>
  <p class="muted">Text segments extracted per source location{% if result.extraction_summary.truncated %}. Limits were reached, so part of this page was not analysed{% endif %}.</p>
  <table>
    <thead><tr><th>Source location</th><th>Segments</th></tr></thead>
    <tbody>
    {% for source, count in result.extraction_summary.sources.items() %}
      <tr><td>{{ source.replace("_", " ") }}</td><td>{{ count }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if checklist %}
  <h2>Remediation checklist</h2>
  <ul class="checklist">
    {% for item in checklist %}<li>{{ item }}</li>{% endfor %}
  </ul>
  {% endif %}

  <h2>Limitations</h2>
  <ul>
    {% for item in result.limitations %}<li>{{ item }}</li>{% endfor %}
  </ul>

  <p class="notice"><strong>Disclaimer.</strong> For authorized, educational, and defensive security research only. A clean scan does not certify that a page is safe.</p>

  <footer>ShadowPrompt v{{ version }} &middot; ShadowScan static analysis. The scanned page was parsed, never executed.</footer>
</main>
</body>
</html>
