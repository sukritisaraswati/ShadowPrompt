# ---------------------------------------------------------------------------
# ShadowPrompt environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Core ---
SHADOWPROMPT_ENV=development
SHADOWPROMPT_DEBUG=true
SHADOWPROMPT_LOG_LEVEL=INFO

# --- Database ---
# Production / Docker Compose target (PostgreSQL + asyncpg):
#   postgresql+asyncpg://shadowprompt:shadowprompt@db:5432/shadowprompt
# Local dev fallback with no PostgreSQL installed (SQLite + aiosqlite):
#   sqlite+aiosqlite:///./shadowprompt.db
DATABASE_URL=sqlite+aiosqlite:///./shadowprompt.db

# --- CORS: origins allowed to call the API (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Layer 3 evaluator (Release 3) ---
# The PLATFORM's own Anthropic key, used only by the meta-evaluator.
# This is never the key under test; a user's LLM key is never persisted at all.
ANTHROPIC_API_KEY=
LAYER3_MODEL=claude-sonnet-5-5
LAYER3_ENABLED=false
LAYER3_MAX_CALLS_PER_CAMPAIGN=40

# --- Outbound fetch limits (ShadowScan SSRF controls) ---
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_REDIRECTS=3
FETCH_MAX_BYTES=5242880
UPLOAD_MAX_BYTES=2097152

# --- LLM proxy limits (Lab) ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RESPONSE_BYTES=1048576
LLM_MAX_OUTPUT_TOKENS=400
MAX_CONCURRENT_CAMPAIGNS=3
# Allow model endpoints on localhost and private networks (Ollama, LM Studio,
# the bundled stub model). For self-hosted and development use ONLY: on a
# shared server this would let users reach internal services. Cloud metadata
# addresses stay blocked either way.
LLM_ALLOW_PRIVATE_ENDPOINTS=false

# --- Rate limiting ---
RATE_LIMIT_SCANS_PER_MINUTE=10
RATE_LIMIT_CAMPAIGNS_PER_HOUR=5
RATE_LIMIT_PACK_UPLOADS_PER_HOUR=20

# --- Custom test packs ---
# Lets users upload their own Lab tests. Uploads are validated strictly and
# the number of stored packs is capped.
CUSTOM_PACKS_ENABLED=true
CUSTOM_PACKS_MAX_STORED=200

# --- JavaScript rendering for ShadowScan ---
# Needs the render extra and Chromium (or an image built with INSTALL_RENDER=true).
SCANNER_RENDER_ENABLED=false
INSTALL_RENDER=false

# --- Hosted attack pages for chatbot tests ---
# The address your chatbot can reach this install at, e.g. https://shadowprompt.example.com.
# Empty turns hosted delivery off; indirect tests are then pasted into the message.
PUBLIC_BASE_URL=
